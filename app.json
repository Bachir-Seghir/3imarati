{
	"expo": {
		"name": "3imarati",
		"slug": "3imarati",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "imarati",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"predictiveBackGestureEnabled": false,
			"permissions": ["android.permission.RECORD_AUDIO"],
			"package": "com.imarati.app"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/icon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "L'application accède aux photos pour ajouter des factures.",
					"cameraPermission": "L'application accède à la caméra pour prendre des photos."
				}
			],
			"expo-font",
			"expo-image",
			"expo-status-bar",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "71cd84e1-8874-4286-8290-7f007f3f9e6e"
			}
		}
	}
}
